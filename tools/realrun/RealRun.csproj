<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Прогон настоящего кода приложения — без WPF — на книгах, повторяющих
    рабочие файлы заказчика. Слои Domain, Application и Infrastructure не
    зависят от окон, поэтому собираются под .NET 8 и запускаются на Linux.

    Запуск:  python3 tools/realrun/make_fixtures.py
             dotnet run, проект tools/realrun, аргумент tools/realrun
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS1998;CS8632</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../ParkApp/components/Domain/*.cs" />
    <Compile Include="../../ParkApp/components/Application/*.cs" />
    <Compile Include="../../ParkApp/components/Infrastructure/**/*.cs"
             Exclude="../../ParkApp/components/Infrastructure/WpfFileDialogService.cs" />
    <Compile Include="Program.cs" />
  </ItemGroup>
</Project>
