<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
    <appSettings>
        <!-- Свои документы: папка «Штрафы» с таблицей и сканами.
             Пусто — каталог приложения. У каждого рабочего места своя. -->
        <add key="DataRoot" value="" />

        <!-- Общие справочники: папки «Машины» и «Люди».
             Пусто — там же, где DataRoot.
             Можно указать общую папку, например \\server\ParkApp — приложение
             эти таблицы только читает, поэтому нескольким ПК это не мешает. -->
        <add key="SharedRoot" value="" />
    </appSettings>
</configuration>
