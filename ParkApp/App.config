<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
    <appSettings>
        <!-- Корень данных: папки «Машины» и «Штрафы» с таблицами и сканами.
             Пусто — каталог приложения. Можно указать путь к сетевой шаре,
             например \\server\ParkApp — тогда данными пользуются несколько ПК. -->
        <add key="DataRoot" value="" />
    </appSettings>
</configuration>
