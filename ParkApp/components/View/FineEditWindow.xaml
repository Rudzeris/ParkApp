<Window x:Class="ParkApp.components.View.FineEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Height="640" Width="680"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanMinimize">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="190" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="Номер постановления:" Margin="0,6" VerticalAlignment="Center" />
        <TextBox Grid.Row="0" Grid.Column="1" Margin="0,6"
                 Text="{Binding ResolutionNumber, UpdateSourceTrigger=PropertyChanged}"
                 IsEnabled="{Binding CanEditNumber}"
                 ToolTip="Ключ записи. У сохранённой записи не меняется." />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Дата привлечения:" Margin="0,6" VerticalAlignment="Center" />
        <DatePicker Grid.Row="1" Grid.Column="1" Margin="0,6" HorizontalAlignment="Left" Width="160"
                    SelectedDate="{Binding ResolutionDate}" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Дата правонарушения:" Margin="0,6" VerticalAlignment="Center" />
        <DatePicker Grid.Row="2" Grid.Column="1" Margin="0,6" HorizontalAlignment="Left" Width="160"
                    SelectedDate="{Binding ViolationDate}" />

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Ф.И.О. правонарушителя:" Margin="0,6" VerticalAlignment="Center" />
        <TextBox Grid.Row="3" Grid.Column="1" Margin="0,6"
                 Text="{Binding OffenderName, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="В книге хранится в одной ячейке с датой правонарушения" />

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Машина из реестра:" Margin="0,6" VerticalAlignment="Center" />
        <DockPanel Grid.Row="4" Grid.Column="1" Margin="0,6">
            <Button DockPanel.Dock="Right" Content="Подставить" Width="110" Padding="0,2" Margin="6,0,0,0"
                    Command="{Binding UseRegistryCarCommand}"
                    ToolTip="Заполнить марку и ГРЗ из карточки машины" />
            <ComboBox ItemsSource="{Binding Cars}"
                      DisplayMemberPath="Display"
                      SelectedItem="{Binding SelectedCar}" />
        </DockPanel>

        <TextBlock Grid.Row="5" Grid.Column="0" Text="Марка АТ:" Margin="0,6" VerticalAlignment="Center" />
        <TextBox Grid.Row="5" Grid.Column="1" Margin="0,6"
                 Text="{Binding CarBrand, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="6" Grid.Column="0" Text="ГРЗ:" Margin="0,6" VerticalAlignment="Center" />
        <TextBox Grid.Row="6" Grid.Column="1" Margin="0,6" HorizontalAlignment="Left" Width="200"
                 Text="{Binding CarPlate, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="7" Grid.Column="0" Text="Сумма штрафа, руб.:" Margin="0,6" VerticalAlignment="Center" />
        <TextBox Grid.Row="7" Grid.Column="1" Margin="0,6" HorizontalAlignment="Left" Width="160"
                 Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="8" Grid.Column="0" Text="Оплата:" Margin="0,6" VerticalAlignment="Center" />
        <StackPanel Grid.Row="8" Grid.Column="1" Margin="0,6">
            <StackPanel Orientation="Horizontal">
                <CheckBox Content="оплачен" IsChecked="{Binding IsPaid}" VerticalAlignment="Center" />
                <TextBlock Text="дата:" VerticalAlignment="Center" Margin="16,0,6,0" />
                <DatePicker Width="150" SelectedDate="{Binding PaidDate}"
                            ToolTip="Можно оставить пустой — отметка «оплачен» останется" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBlock Text="ИД платежа / чек:" VerticalAlignment="Center" />
                <TextBox Width="260" Margin="6,0,0,0"
                         Text="{Binding PaymentReference, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="9" Grid.Column="0" Text="Примечание:" Margin="0,6" VerticalAlignment="Center" />
        <TextBox Grid.Row="9" Grid.Column="1" Margin="0,6"
                 Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="10" Grid.Column="0" Text="Скан постановления:" Margin="0,6" VerticalAlignment="Center" />
        <StackPanel Grid.Row="10" Grid.Column="1" Orientation="Horizontal" Margin="0,6">
            <TextBlock Text="{Binding ScanDisplay}" VerticalAlignment="Center" Width="180"
                       TextTrimming="CharacterEllipsis" />
            <Button Content="Вложить…" Command="{Binding AttachScanCommand}" Padding="10,2" Margin="6,0,0,0" />
            <Button Content="Открыть" Command="{Binding OpenScanCommand}" Padding="10,2" Margin="6,0,0,0" />
            <Button Content="Убрать" Command="{Binding RemoveScanCommand}" Padding="10,2" Margin="6,0,0,0" />
        </StackPanel>

        <Border Grid.Row="11" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,12,0,0"
                Padding="8" BorderBrush="#C0392B" BorderThickness="1" Background="#FDF3F2"
                VerticalAlignment="Top"
                Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="Проверьте данные:" FontWeight="Bold" Foreground="#C0392B" Margin="0,0,0,4" />
                <ItemsControl ItemsSource="{Binding Errors}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="#C0392B" TextWrapping="Wrap" Margin="0,1" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="12" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Сохранить" Command="{Binding SaveCommand}" IsDefault="True"
                    Width="120" Padding="0,4" />
            <Button Content="Отмена" Command="{Binding CancelCommand}"
                    Width="120" Padding="0,4" Margin="8,0,0,0" />
        </StackPanel>

    </Grid>
</Window>
