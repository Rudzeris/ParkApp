<Window x:Class="ParkApp.components.View.FineEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Title}" Height="540" Width="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanMinimize">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>

    <Grid Margin="12">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="170" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Grid.Column="0" Text="№ постановления:" Margin="0,6" VerticalAlignment="Center" />
        <TextBox Grid.Row="0" Grid.Column="1" Margin="0,6"
                 Text="{Binding ResolutionNumber, UpdateSourceTrigger=PropertyChanged}"
                 IsEnabled="{Binding CanEditNumber}"
                 ToolTip="Ключ записи. У сохранённого штрафа не меняется." />

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Дата постановления:" Margin="0,6" VerticalAlignment="Center" />
        <DatePicker Grid.Row="1" Grid.Column="1" Margin="0,6" HorizontalAlignment="Left" Width="160"
                    SelectedDate="{Binding ResolutionDate}" />

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Дата нарушения:" Margin="0,6" VerticalAlignment="Center" />
        <DatePicker Grid.Row="2" Grid.Column="1" Margin="0,6" HorizontalAlignment="Left" Width="160"
                    SelectedDate="{Binding ViolationDate}" />

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Машина:" Margin="0,6" VerticalAlignment="Center" />
        <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,6"
                  ItemsSource="{Binding Cars}"
                  DisplayMemberPath="Display"
                  SelectedItem="{Binding SelectedCar}" />

        <TextBlock Grid.Row="4" Grid.Column="0" Text="Водитель:" Margin="0,6" VerticalAlignment="Center" />
        <ComboBox Grid.Row="4" Grid.Column="1" Margin="0,6"
                  ItemsSource="{Binding Drivers}"
                  DisplayMemberPath="Display"
                  SelectedItem="{Binding SelectedDriver}"
                  ToolTip="Из справочника людей. «Не установлен» — если виновник неизвестен" />

        <TextBlock Grid.Row="5" Grid.Column="0" Text="Место нарушения:" Margin="0,6" VerticalAlignment="Center" />
        <TextBox Grid.Row="5" Grid.Column="1" Margin="0,6"
                 Text="{Binding ViolationPlace, UpdateSourceTrigger=PropertyChanged}"
                 ToolTip="Необязательное поле" />

        <TextBlock Grid.Row="6" Grid.Column="0" Text="Сумма, руб.:" Margin="0,6" VerticalAlignment="Center" />
        <TextBox Grid.Row="6" Grid.Column="1" Margin="0,6" HorizontalAlignment="Left" Width="160"
                 Text="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}" />

        <TextBlock Grid.Row="7" Grid.Column="0" Text="Оплата:" Margin="0,6" VerticalAlignment="Center" />
        <StackPanel Grid.Row="7" Grid.Column="1" Orientation="Horizontal" Margin="0,6">
            <CheckBox Content="оплачен" IsChecked="{Binding IsPaid}" VerticalAlignment="Center" />
            <TextBlock Text="дата оплаты:" VerticalAlignment="Center" Margin="16,0,6,0" />
            <DatePicker Width="150" SelectedDate="{Binding PaidDate}"
                        ToolTip="Можно оставить пустой — отметка «оплачен» останется" />
        </StackPanel>

        <TextBlock Grid.Row="8" Grid.Column="0" Text="Скан постановления:" Margin="0,6" VerticalAlignment="Center" />
        <StackPanel Grid.Row="8" Grid.Column="1" Orientation="Horizontal" Margin="0,6">
            <TextBlock Text="{Binding ScanDisplay}" VerticalAlignment="Center" Width="200"
                       TextTrimming="CharacterEllipsis" />
            <Button Content="Вложить…" Command="{Binding AttachScanCommand}" Padding="10,2" Margin="6,0,0,0" />
            <Button Content="Открыть" Command="{Binding OpenScanCommand}" Padding="10,2" Margin="6,0,0,0" />
            <Button Content="Убрать" Command="{Binding RemoveScanCommand}" Padding="10,2" Margin="6,0,0,0" />
        </StackPanel>

        <Border Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="2" Margin="0,12,0,0"
                Padding="8" BorderBrush="#C0392B" BorderThickness="1" Background="#FDF3F2"
                VerticalAlignment="Top"
                Visibility="{Binding HasErrors, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="Проверьте данные:" FontWeight="Bold" Foreground="#C0392B" Margin="0,0,0,4" />
                <ItemsControl ItemsSource="{Binding Errors}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="#C0392B" TextWrapping="Wrap" Margin="0,1" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Сохранить" Command="{Binding SaveCommand}" IsDefault="True"
                    Width="120" Padding="0,4" />
            <Button Content="Отмена" Command="{Binding CancelCommand}"
                    Width="120" Padding="0,4" Margin="8,0,0,0" />
        </StackPanel>

    </Grid>
</Window>
