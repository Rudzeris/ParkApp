<Window x:Class="ParkApp.components.View.SheetPickWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выбор листа" Height="230" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="MessageText" Grid.Row="0" TextWrapping="Wrap" Margin="0,0,0,10" />

        <TextBlock Grid.Row="1" Text="Имя листа:" Margin="0,0,0,4" />

        <ComboBox x:Name="SheetBox" Grid.Row="2" IsEditable="True" />

        <TextBlock Grid.Row="3" Foreground="Gray" TextWrapping="Wrap" Margin="0,8,0,0"
                   Text="Можно выбрать из списка листов книги или вписать имя вручную." />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="ОК" Click="OnOkClick" IsDefault="True" Width="110" Padding="0,4" />
            <Button Content="Отмена" Click="OnCancelClick" Width="110" Padding="0,4" Margin="8,0,0,0" />
        </StackPanel>
    </Grid>
</Window>
