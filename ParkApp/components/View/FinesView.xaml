<UserControl x:Class="ParkApp.components.View.FinesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <DockPanel>

        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Content="Добавить" Command="{Binding AddCommand}" Padding="10,2" />
                <Button Content="Изменить" Command="{Binding EditCommand}" Padding="10,2" />
                <Button Content="Удалить" Command="{Binding DeleteCommand}" Padding="10,2" />
                <Separator />
                <Button Content="Открыть скан постановления" Command="{Binding OpenScanCommand}" Padding="10,2" />
                <Separator />
                <Button Content="Обновить" Command="{Binding RefreshCommand}" Padding="10,2" />
            </ToolBar>
        </ToolBarTray>

        <GroupBox DockPanel.Dock="Top" Header="Отбор" Margin="6,6,6,0">
            <StackPanel Margin="4">

                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock Text="Машина:" VerticalAlignment="Center" Width="90" />
                    <ComboBox Width="320"
                              ItemsSource="{Binding CarOptions}"
                              DisplayMemberPath="Display"
                              SelectedItem="{Binding SelectedCarOption}"
                              ToolTip="Отбор по гос. рег. знаку из реестра машин" />

                    <TextBlock Text="Правонарушитель:" VerticalAlignment="Center" Margin="16,0,6,0" />
                    <TextBox Width="200"
                             Text="{Binding OffenderFilter, UpdateSourceTrigger=PropertyChanged, Delay=300}" />

                    <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="16,0,6,0" />
                    <TextBox Width="200"
                             ToolTip="Номер постановления, марка или примечание"
                             Text="{Binding TextFilter, UpdateSourceTrigger=PropertyChanged, Delay=300}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Нарушение с:" VerticalAlignment="Center" Width="90" />
                    <DatePicker Width="130" SelectedDate="{Binding DateFrom}" />

                    <TextBlock Text="по:" VerticalAlignment="Center" Margin="16,0,6,0" />
                    <DatePicker Width="130" SelectedDate="{Binding DateTo}" />

                    <TextBlock Text="Оплата:" VerticalAlignment="Center" Margin="16,0,6,0" />
                    <ComboBox Width="150"
                              ItemsSource="{Binding PaymentOptions}"
                              DisplayMemberPath="Display"
                              SelectedItem="{Binding SelectedPaymentOption}" />

                    <Button Content="Сбросить отбор"
                            Command="{Binding ResetFilterCommand}"
                            Margin="16,0,0,0" Padding="10,2" />
                </StackPanel>

            </StackPanel>
        </GroupBox>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock Text="{Binding Status}" />
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Итого: " FontWeight="Bold" />
                    <TextBlock Text="{Binding Total, StringFormat={}{0:N2}}" FontWeight="Bold" />
                    <TextBlock Text=" руб." FontWeight="Bold" />
                </StackPanel>
            </StatusBarItem>
            <Separator />
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Не оплачено: " Foreground="#C0392B" />
                    <TextBlock Text="{Binding UnpaidTotal, StringFormat={}{0:N2}}" Foreground="#C0392B" FontWeight="Bold" />
                    <TextBlock Text=" руб." Foreground="#C0392B" />
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <ListView x:Name="Rows" Margin="6"
                  ItemsSource="{Binding Fines}"
                  SelectedItem="{Binding SelectedFine}">
            <ListView.InputBindings>
                <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding EditCommand}" />
            </ListView.InputBindings>

            <!--
                Меню висит на списке, а не на строке: у меню строки
                DataContext — сама строка, а команды живут в модели окна.
            -->
            <ListView.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Изменить" Command="{Binding EditCommand}" />
                    <MenuItem Header="Удалить" Command="{Binding DeleteCommand}" />
                    <Separator />
                    <MenuItem Header="Открыть скан постановления" Command="{Binding OpenScanCommand}" />
                </ContextMenu>
            </ListView.ContextMenu>

            <!--
                Правая кнопка сначала выделяет строку, а потом показывает меню:
                иначе команда применилась бы к строке, выделенной до этого,
                а человек видит меню над той, по которой щёлкнул.
            -->
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <EventSetter Event="PreviewMouseRightButtonDown" Handler="OnRowRightClick" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="№ п/п" Width="50"
                                    DisplayMemberBinding="{Binding RowNumber}" />
                    <GridViewColumn Header="Дата правонарушения" Width="130"
                                    DisplayMemberBinding="{Binding ViolationDate, StringFormat={}{0:dd.MM.yyyy}}" />
                    <GridViewColumn Header="Ф.И.О. правонарушителя" Width="180"
                                    DisplayMemberBinding="{Binding OffenderName}" />
                    <GridViewColumn Header="Марка АТ" Width="110"
                                    DisplayMemberBinding="{Binding CarBrand}" />
                    <GridViewColumn Header="ГРЗ" Width="110"
                                    DisplayMemberBinding="{Binding CarPlate}" />
                    <GridViewColumn Header="В реестре" Width="110"
                                    DisplayMemberBinding="{Binding RegistryText}" />
                    <GridViewColumn Header="Дата привлечения" Width="120"
                                    DisplayMemberBinding="{Binding ResolutionDate, StringFormat={}{0:dd.MM.yyyy}}" />
                    <GridViewColumn Header="Номер постановления" Width="160"
                                    DisplayMemberBinding="{Binding ResolutionNumber}" />
                    <GridViewColumn Header="Сумма, руб." Width="90">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Amount, StringFormat={}{0:N2}}"
                                           HorizontalAlignment="Right" />
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Оплата, чек, дата" Width="230"
                                    DisplayMemberBinding="{Binding PaidText}" />
                    <GridViewColumn Header="Примечание" Width="180"
                                    DisplayMemberBinding="{Binding Notes}" />
                    <GridViewColumn Header="Скан" Width="55"
                                    DisplayMemberBinding="{Binding ScanMark}" />
                </GridView>
            </ListView.View>
        </ListView>

    </DockPanel>
</UserControl>
