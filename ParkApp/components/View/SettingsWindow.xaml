<Window x:Class="ParkApp.components.View.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки" Height="700" Width="780"
        WindowStartupLocation="CenterOwner">

    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <DockPanel Margin="12">

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Сохранить" Command="{Binding SaveCommand}" IsDefault="True"
                    Width="120" Padding="0,4" />
            <Button Content="Отмена" Command="{Binding CancelCommand}"
                    Width="120" Padding="0,4" Margin="8,0,0,0" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <GroupBox Header="Разделы" Padding="8">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="Отметьте разделы, с которыми работаете. Невыбранные не появятся на панели главного окна." />
                        <ItemsControl ItemsSource="{Binding Sections}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" Margin="2">
                                        <CheckBox IsChecked="{Binding IsEnabled}"
                                                  IsEnabled="{Binding IsAvailable}"
                                                  Content="{Binding Title}"
                                                  VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Note}" Foreground="Gray" Margin="8,0,0,0"
                                                   VerticalAlignment="Center" FontStyle="Italic" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Где лежат данные" Padding="8" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="Пустое поле — путь по умолчанию, он показан серым. Выбранный файл проверяется по столбцам сразу." />

                        <ItemsControl ItemsSource="{Binding Paths}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,12">

                                        <TextBlock Text="{Binding Title}" FontWeight="Bold" />

                                        <DockPanel Margin="0,4,0,0">
                                            <Button DockPanel.Dock="Right" Content="Сброс" Width="70" Padding="0,2"
                                                    Margin="6,0,0,0"
                                                    Command="{Binding DataContext.ResetPathCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                            <Button DockPanel.Dock="Right" Content="Обзор…" Width="90" Padding="0,2"
                                                    Margin="6,0,0,0"
                                                    Command="{Binding DataContext.BrowsePathCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                        </DockPanel>

                                        <TextBlock Margin="0,3,0,0" Foreground="Gray" TextWrapping="Wrap">
                                            <Run Text="Сейчас:" />
                                            <Run Text="{Binding EffectivePath, Mode=OneWay}" />
                                            <Run Text="—" />
                                            <Run Text="{Binding Hint, Mode=OneWay}" />
                                        </TextBlock>

                                        <DockPanel Margin="0,4,0,0"
                                                   Visibility="{Binding HasSheet, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock DockPanel.Dock="Left" Text="Лист:" VerticalAlignment="Center"
                                                       Margin="0,0,6,0" />
                                            <Button DockPanel.Dock="Right" Content="Выбрать лист…" Width="130" Padding="0,2"
                                                    Margin="6,0,0,0"
                                                    Command="{Binding DataContext.PickSheetCommand,
                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}" />
                                            <TextBox Text="{Binding SheetName, UpdateSourceTrigger=PropertyChanged}" />
                                        </DockPanel>

                                        <TextBlock Text="{Binding Note}" Foreground="#B7950B" TextWrapping="Wrap"
                                                   Margin="0,3,0,0"
                                                   Visibility="{Binding HasNote, Converter={StaticResource BoolToVisibility}}" />

                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock TextWrapping="Wrap" Foreground="Gray" FontStyle="Italic"
                                   Text="Пути по умолчанию пересчитаются после сохранения." />
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Справочные листы в файле машин" Padding="8" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                                   Text="Списки значений лежат отдельными листами в файле машин: столбец A, в A1 «Название»." />
                        <ItemsControl ItemsSource="{Binding Sheets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,6">
                                        <TextBlock DockPanel.Dock="Left" Text="{Binding Title}" Width="200"
                                                   VerticalAlignment="Center" />
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

    </DockPanel>
</Window>
