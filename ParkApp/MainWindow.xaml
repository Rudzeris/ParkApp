<Window x:Class="ParkApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ParkApp"
        mc:Ignorable="d"
        Title="Автопарк" Height="420" Width="700">
    <DockPanel>
        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar>
                <Button Content="Штрафы" Click="OnFinesClick" Padding="12,2" />
            </ToolBar>
        </ToolBarTray>

        <ListView ItemsSource="{Binding Cars}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Модель" Width="140" DisplayMemberBinding="{Binding Model}" />
                    <GridViewColumn Header="VIN" Width="160" DisplayMemberBinding="{Binding Vin}" />
                    <GridViewColumn Header="Год" Width="60" DisplayMemberBinding="{Binding Year}" />
                    <GridViewColumn Header="Местонахождение" Width="150" DisplayMemberBinding="{Binding Location}" />
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
